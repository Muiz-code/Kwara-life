# Copy this file to .env.local and fill in the values. .env.local is git-ignored; never commit real keys.
#
# Supabase: Project Settings > API Keys (https://supabase.com/dashboard/project/ykdpwbxfkarnhttdnute/settings/api-keys)
# We use the new key types: "publishable" (sb_publishable_...) and "secret" (sb_secret_...).

# The project URL. Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://ykdpwbxfkarnhttdnute.supabase.co

# The publishable key (sb_publishable_...). Safe in the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key (sb_secret_...). SERVER ONLY: it bypasses Row Level Security.
# The older service_role key also works under the name SUPABASE_SERVICE_ROLE_KEY.
# Never give it a NEXT_PUBLIC_ prefix, never paste it in chat, never commit it.
SUPABASE_SECRET_KEY=

# Testers only: 1 builds the ?debug tools (clock jumps, window.kwara) into a production build.
# Leave unset or 0 for the real game.
NEXT_PUBLIC_ALLOW_DEBUG=0

# Later, when ad payments go live (Paystack dashboard > Settings > API Keys & Webhooks):
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# PAYSTACK_SECRET_KEY=
