# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template with no real values is safe to commit.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw Higgsfield downloads (rebuild with scripts/fetch_assets.py)
/public/assets/raw/
__pycache__/
.osm-cache/
# map screenshots from scripts/osm-shot.mjs
/shots/

# Quaternius source packs (CC0), 186 MB: only the optimised models in public/models are shipped.
reference/quaternius/
